# Runlock starts safely in demo mode. No credentials are required for npm run dev.
RUNLOCK_MODE=demo

# KeeperHub live integration
KEEPERHUB_API_URL=https://app.keeperhub.com/api
KEEPERHUB_API_KEY=
KEEPERHUB_MONITOR_WORKFLOW_ID=

# Sepolia Superfluid fDAI/fDAIx contracts used for live reads and exact contract calls.
# Verify these against KeeperHub search_protocol_actions before a live run.
RUNLOCK_SUPER_TOKEN_ADDRESS=0x9ce2062b085a2268e8d769ffc040f6692315fd2c
RUNLOCK_CFA_FORWARDER_ADDRESS=0xcfA132E353cB4E398080B9700609bb008eceB125

# Fail-closed live broadcast switch. Keep false while wiring and simulating.
RUNLOCK_LIVE_EXECUTION=false

# Direct live Sepolia treasury reads
# Required only when RUNLOCK_MODE=live
RUNLOCK_RPC_URL=
RUNLOCK_SAFE_ADDRESS=
RUNLOCK_BASE_TOKEN_ADDRESS=0x4e89088cd14064f38e5b2f309cfab9c864f9a8e6
RUNLOCK_BASE_TOKEN_DECIMALS=18
RUNLOCK_SUPER_TOKEN_DECIMALS=18
RUNLOCK_CFA_ADDRESS=0x6836F23d6171D74Ef62FcF776655aBcD2bcd62Ef
RUNLOCK_MONTHLY_INFLOWS=0
RUNLOCK_OTHER_MONTHLY_COSTS=0
RUNLOCK_STREAMS_JSON=[{"id":"stream-core","receiver":"0x1111111111111111111111111111111111111111","label":"Core engineering","protected":true},{"id":"stream-ops","receiver":"0x2222222222222222222222222222222222222222","label":"Operations","protected":true},{"id":"stream-community","receiver":"0x3333333333333333333333333333333333333333","label":"Community rewards","protected":false},{"id":"stream-tooling","receiver":"0x4444444444444444444444444444444444444444","label":"Experimental tooling","protected":false}]
